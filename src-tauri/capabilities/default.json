{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities pre evidenciu činnosti",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:path:default",
    "core:app:default",
    "fs:default",
    { "identifier": "fs:allow-read-text-file",  "allow": [{ "path": "$APPLOCALDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$APPLOCALDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-read-file",       "allow": [{ "path": "$APPLOCALDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-write-file",      "allow": [{ "path": "$APPLOCALDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-mkdir",           "allow": [{ "path": "$APPLOCALDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-exists",          "allow": [{ "path": "$APPLOCALDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-rename",          "allow": [{ "path": "$APPLOCALDATA/**" }, { "path": "$HOME/**" }] },
    "dialog:allow-open",
    "opener:default",
    { "identifier": "opener:allow-open-path",         "allow": [{ "path": "$APPLOCALDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "opener:allow-reveal-item-in-dir","allow": [{ "path": "$APPLOCALDATA/**" }, { "path": "$HOME/**" }] }
  ]
}
